<?php
/**
 * Pagination of the active CMS tab (p parameter; the filter is kept, page 1 has no p).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */
/** @var \Thedevkitchen\CmsSearch\ViewModel\ResultCards $viewModel */
$viewModel = $block->getData('view_model');
$pagination = $viewModel->getPagination();
if ($pagination['pages'] === []) {
    return;
}
?>
<nav class="cmssearch-pagination" aria-label="<?= $escaper->escapeHtmlAttr(__('Result pages')) ?>" data-cmssearch-pagination>
    <ul class="cmssearch-pagination__list">
        <?php if ($pagination['previous'] !== null): ?>
            <li><a class="cmssearch-pagination__previous" href="<?= $escaper->escapeUrl($pagination['previous']) ?>" rel="prev" data-cmssearch-page="previous"><?= $escaper->escapeHtml(__('Previous page')) ?></a></li>
        <?php endif; ?>
        <?php foreach ($pagination['pages'] as $page): ?>
            <li>
                <?php if ($page['current']): ?>
                    <span class="cmssearch-pagination__current" aria-current="page" data-cmssearch-page="<?= (int) $page['number'] ?>"><?= (int) $page['number'] ?></span>
                <?php else: ?>
                    <a href="<?= $escaper->escapeUrl($page['url']) ?>" aria-label="<?= $escaper->escapeHtmlAttr(__('Page %1', $page['number'])) ?>" data-cmssearch-page="<?= (int) $page['number'] ?>"><?= (int) $page['number'] ?></a>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
        <?php if ($pagination['next'] !== null): ?>
            <li><a class="cmssearch-pagination__next" href="<?= $escaper->escapeUrl($pagination['next']) ?>" rel="next" data-cmssearch-page="next"><?= $escaper->escapeHtml(__('Next page')) ?></a></li>
        <?php endif; ?>
    </ul>
</nav>
