<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/new"/>
                <class>primary</class>
                <label translate="true">Add New Content Type</label>
                <aclResource>Thedevkitchen_CmsSearch::content_types_create</aclResource>
            </button>
        </buttons>
        <spinner>thedevkitchen_cmssearch_content_type_columns</spinner>
        <deps>
            <dep>thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="thedevkitchen_cmssearch_content_type_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">type_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Thedevkitchen_CmsSearch::content_types</aclResource>
        <dataProvider class="Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\ListingDataProvider"
                      name="thedevkitchen_cmssearch_content_type_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>type_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Are you sure you want to delete the selected content types? Types linked to CMS pages are skipped.</message>
                        <title translate="true">Delete content types</title>
                    </confirm>
                    <url path="thedevkitchen_cmssearch/contenttype/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
            <action name="status">
                <settings>
                    <type>status</type>
                    <label translate="true">Change status</label>
                    <actions>
                        <action name="0">
                            <type>enable</type>
                            <label translate="true">Enable</label>
                            <url path="thedevkitchen_cmssearch/contenttype/massStatus">
                                <param name="status">1</param>
                            </url>
                        </action>
                        <action name="1">
                            <type>disable</type>
                            <label translate="true">Disable</label>
                            <url path="thedevkitchen_cmssearch/contenttype/massStatus">
                                <param name="status">0</param>
                            </url>
                        </action>
                    </actions>
                </settings>
            </action>
            <action name="edit">
                <settings>
                    <callback>
                        <target>editSelected</target>
                        <provider>thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_columns_editor</provider>
                    </callback>
                    <type>edit</type>
                    <label translate="true">Edit</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="thedevkitchen_cmssearch_content_type_columns">
        <settings>
            <editorConfig>
                <param name="clientConfig" xsi:type="array">
                    <item name="saveUrl" xsi:type="url" path="thedevkitchen_cmssearch/contenttype/inlineEdit"/>
                    <item name="validateBeforeSave" xsi:type="boolean">false</item>
                </param>
                <param name="indexField" xsi:type="string">type_id</param>
                <param name="enabled" xsi:type="boolean">true</param>
                <param name="selectProvider" xsi:type="string">thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_columns.ids</param>
            </editorConfig>
            <childDefaults>
                <param name="fieldAction" xsi:type="array">
                    <item name="provider" xsi:type="string">thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_listing.thedevkitchen_cmssearch_content_type_columns_editor</item>
                    <item name="target" xsi:type="string">startEdit</item>
                    <item name="params" xsi:type="array">
                        <item name="0" xsi:type="string">${ $.$data.rowIndex }</item>
                        <item name="1" xsi:type="boolean">true</item>
                    </item>
                </param>
            </childDefaults>
        </settings>
        <selectionsColumn name="ids">
            <settings>
                <indexField>type_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="type_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>
        <column name="code">
            <settings>
                <filter>text</filter>
                <label translate="true">Code</label>
            </settings>
        </column>
        <column name="default_label">
            <settings>
                <filter>text</filter>
                <label translate="true">Label</label>
            </settings>
        </column>
        <column name="sort_order">
            <settings>
                <filter>textRange</filter>
                <editor>
                    <validation>
                        <rule name="validate-digits" xsi:type="boolean">true</rule>
                    </validation>
                    <editorType>text</editorType>
                </editor>
                <label translate="true">Tab order</label>
            </settings>
        </column>
        <column name="is_active" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Enabledisable"/>
                <filter>select</filter>
                <editor>
                    <editorType>select</editorType>
                </editor>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="pages_count">
            <settings>
                <filter>false</filter>
                <label translate="true">Linked pages</label>
            </settings>
        </column>
        <actionsColumn name="actions" class="Thedevkitchen\CmsSearch\Ui\Component\Listing\Column\ContentTypeActions">
            <settings>
                <indexField>type_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
