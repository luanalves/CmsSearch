<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework-message-queue:etc/topology.xsd">
    <!-- Exclusive to this module (D10). The binding arguments become the main queue's queue_declare arguments:
         a rejected message (requeue=false) is dead-lettered into thedevkitchen.cmssearch.reindex.dlq.
         RabbitMQ refuses to redeclare an existing queue with other arguments: see TECHNICAL-REFERENCE.md before changing them. -->
    <exchange name="thedevkitchen.cmssearch" type="topic" connection="amqp">
        <binding id="ThedevkitchenCmsSearchReindexBinding" topic="thedevkitchen.cmssearch.reindex"
                 destinationType="queue" destination="thedevkitchen.cmssearch.reindex">
            <arguments>
                <argument name="x-dead-letter-exchange" xsi:type="string">thedevkitchen.cmssearch.dlx</argument>
                <argument name="x-dead-letter-routing-key" xsi:type="string">thedevkitchen.cmssearch.reindex.dead</argument>
            </arguments>
        </binding>
    </exchange>
    <exchange name="thedevkitchen.cmssearch.dlx" type="topic" connection="amqp">
        <binding id="ThedevkitchenCmsSearchReindexDlqBinding" topic="thedevkitchen.cmssearch.reindex.dead"
                 destinationType="queue" destination="thedevkitchen.cmssearch.reindex.dlq"/>
    </exchange>
</config>
