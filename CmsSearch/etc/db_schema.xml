<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="thedevkitchen_cmssearch_content_type" resource="default" engine="innodb" comment="CMS Search editorial content type">
        <column xsi:type="int" name="type_id" unsigned="true" nullable="false" identity="true" comment="Type ID"/>
        <column xsi:type="varchar" name="code" nullable="false" length="64" comment="Unique code"/>
        <column xsi:type="smallint" name="sort_order" unsigned="true" nullable="false" default="0" comment="Tab order"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="type_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="THEDEVKITCHEN_CMSSEARCH_CONTENT_TYPE_CODE">
            <column name="code"/>
        </constraint>
    </table>

    <table name="thedevkitchen_cmssearch_content_type_label" resource="default" engine="innodb" comment="CMS Search content type label per store view">
        <column xsi:type="int" name="type_id" unsigned="true" nullable="false" comment="Type ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID (0 = default label)"/>
        <column xsi:type="varchar" name="label" nullable="false" length="255" comment="Label"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="type_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_CT_LABEL_TYPE_ID"
                    table="thedevkitchen_cmssearch_content_type_label" column="type_id"
                    referenceTable="thedevkitchen_cmssearch_content_type" referenceColumn="type_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_CT_LABEL_STORE_ID"
                    table="thedevkitchen_cmssearch_content_type_label" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>

    <table name="thedevkitchen_cmssearch_page_classification" resource="default" engine="innodb" comment="CMS Search type and term of a CMS Page">
        <column xsi:type="smallint" name="page_id" unsigned="false" nullable="false" comment="cms_page.page_id (stable under Staging)"/>
        <column xsi:type="int" name="type_id" unsigned="true" nullable="false" comment="Content type"/>
        <column xsi:type="int" name="term_id" unsigned="true" nullable="false" comment="Classification term"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="page_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_PAGECLS_TYPE_ID"
                    table="thedevkitchen_cmssearch_page_classification" column="type_id"
                    referenceTable="thedevkitchen_cmssearch_content_type" referenceColumn="type_id" onDelete="NO ACTION"/>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_PAGECLS_PAGE_ID_SEQUENCE_CMS_PAGE_SEQUENCE_VALUE"
                    table="thedevkitchen_cmssearch_page_classification" column="page_id"
                    referenceTable="sequence_cms_page" referenceColumn="sequence_value" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_PAGECLS_TERM_ID"
                    table="thedevkitchen_cmssearch_page_classification" column="term_id"
                    referenceTable="thedevkitchen_cmssearch_classification_term" referenceColumn="term_id" onDelete="NO ACTION"/>
        <index referenceId="THEDEVKITCHEN_CMSSEARCH_PAGECLS_TYPE_ID_IDX" indexType="btree">
            <column name="type_id"/>
        </index>
        <index referenceId="THEDEVKITCHEN_CMSSEARCH_PAGECLS_TERM_ID_IDX" indexType="btree">
            <column name="term_id"/>
        </index>
    </table>

    <table name="thedevkitchen_cmssearch_classification_term" resource="default" engine="innodb" comment="CMS Search classification term (tree per website)">
        <column xsi:type="int" name="term_id" unsigned="true" nullable="false" identity="true" comment="Term ID"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website ID"/>
        <column xsi:type="int" name="parent_id" unsigned="true" nullable="true" comment="Parent term (NULL = root)"/>
        <column xsi:type="varchar" name="code" nullable="false" length="64" comment="Code, unique per website"/>
        <column xsi:type="varchar" name="path" nullable="false" length="255" default="" comment="Ids from the root to the term, e.g. 1/4/9"/>
        <column xsi:type="smallint" name="level" unsigned="true" nullable="false" default="0" comment="Depth, 0 = root"/>
        <column xsi:type="int" name="sort_order" unsigned="true" nullable="false" default="0" comment="Order among siblings"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" default="1" comment="Is active"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="term_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="THEDEVKITCHEN_CMSSEARCH_TERM_WEBSITE_ID_CODE">
            <column name="website_id"/>
            <column name="code"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_TERM_WEBSITE_ID"
                    table="thedevkitchen_cmssearch_classification_term" column="website_id"
                    referenceTable="store_website" referenceColumn="website_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_TERM_PARENT_ID"
                    table="thedevkitchen_cmssearch_classification_term" column="parent_id"
                    referenceTable="thedevkitchen_cmssearch_classification_term" referenceColumn="term_id" onDelete="NO ACTION"/>
        <index referenceId="THEDEVKITCHEN_CMSSEARCH_TERM_PATH" indexType="btree">
            <column name="path"/>
        </index>
    </table>

    <table name="thedevkitchen_cmssearch_classification_term_label" resource="default" engine="innodb" comment="CMS Search classification term label per store view">
        <column xsi:type="int" name="term_id" unsigned="true" nullable="false" comment="Term ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" comment="Store ID (0 = default label)"/>
        <column xsi:type="varchar" name="label" nullable="false" length="255" comment="Label"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="term_id"/>
            <column name="store_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_TERM_LABEL_TERM_ID"
                    table="thedevkitchen_cmssearch_classification_term_label" column="term_id"
                    referenceTable="thedevkitchen_cmssearch_classification_term" referenceColumn="term_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="THEDEVKITCHEN_CMSSEARCH_TERM_LABEL_STORE_ID"
                    table="thedevkitchen_cmssearch_classification_term_label" column="store_id"
                    referenceTable="store" referenceColumn="store_id" onDelete="CASCADE"/>
    </table>
</schema>
