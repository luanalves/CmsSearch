<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Inside the page save transaction (EntityManager / Staging operations dispatch it before commit). -->
    <event name="cms_page_save_after">
        <observer name="thedevkitchen_cmssearch_save_page_classification"
                  instance="Thedevkitchen\CmsSearch\Observer\SavePageClassification"/>
    </event>
</config>
