<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="thedevkitchen" translate="label" sortOrder="900">
            <label>Thedevkitchen</label>
        </tab>
        <section id="thedevkitchen_cmssearch" translate="label" sortOrder="10"
                 showInDefault="1" showInWebsite="0" showInStore="0">
            <label>CMS Search</label>
            <tab>thedevkitchen</tab>
            <resource>Thedevkitchen_CmsSearch::config</resource>
            <group id="queue" translate="label comment" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Reindex Queue</label>
                <comment>Messages wait in the RabbitMQ queue thedevkitchen.cmssearch.reindex until the consumer of the same name processes them (asynchronous; no refresh interval is imposed).</comment>
                <field id="max_attempts" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Maximum Attempts</label>
                    <comment>Total processing attempts of one reindex message, the first try included, before it is moved to the dead-letter queue thedevkitchen.cmssearch.reindex.dlq. Whole number from 1 to 10; default 3.</comment>
                    <validate>required-entry validate-digits validate-digits-range digits-range-1-10</validate>
                    <backend_model>Thedevkitchen\CmsSearch\Model\Config\Backend\MaxAttempts</backend_model>
                </field>
            </group>
        </section>
    </system>
</config>
