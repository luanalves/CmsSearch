<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Thedevkitchen\CmsSearch\Api\Data\ContentTypeInterface"
                type="Thedevkitchen\CmsSearch\Model\ContentType"/>
    <preference for="Thedevkitchen\CmsSearch\Api\ContentTypeRepositoryInterface"
                type="Thedevkitchen\CmsSearch\Model\ContentTypeRepository"/>
    <preference for="Thedevkitchen\CmsSearch\Api\Data\ContentTypeSearchResultsInterface"
                type="Thedevkitchen\CmsSearch\Model\ContentTypeSearchResults"/>
    <preference for="Thedevkitchen\CmsSearch\Api\Data\ClassificationTermInterface"
                type="Thedevkitchen\CmsSearch\Model\ClassificationTerm"/>
    <preference for="Thedevkitchen\CmsSearch\Api\ClassificationTermRepositoryInterface"
                type="Thedevkitchen\CmsSearch\Model\ClassificationTermRepository"/>
    <preference for="Thedevkitchen\CmsSearch\Api\Data\ClassificationTermSearchResultsInterface"
                type="Thedevkitchen\CmsSearch\Model\ClassificationTermSearchResults"/>
    <preference for="Thedevkitchen\CmsSearch\Api\PageClassificationRepositoryInterface"
                type="Thedevkitchen\CmsSearch\Model\PageClassificationRepository"/>
    <type name="Thedevkitchen\CmsSearch\Model\ResourceModel\ContentType\Grid\Collection">
        <arguments>
            <argument name="mainTable" xsi:type="string">thedevkitchen_cmssearch_content_type</argument>
            <argument name="resourceModel" xsi:type="string">Thedevkitchen\CmsSearch\Model\ResourceModel\ContentType</argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="thedevkitchen_cmssearch_content_type_listing_data_source" xsi:type="string">Thedevkitchen\CmsSearch\Model\ResourceModel\ContentType\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\ContentTypeFilterPool"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\FilterPool">
        <arguments>
            <argument name="appliers" xsi:type="array">
                <item name="regular" xsi:type="object">Magento\Framework\View\Element\UiComponent\DataProvider\RegularFilter</item>
                <item name="fulltext" xsi:type="object">Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\CodeAndLabelFilter</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\ContentTypeReporting"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\Reporting">
        <arguments>
            <argument name="filterPool" xsi:type="object">Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\ContentTypeFilterPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\ListingDataProvider"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
        <arguments>
            <argument name="reporting" xsi:type="object">Thedevkitchen\CmsSearch\Ui\DataProvider\ContentType\ContentTypeReporting</argument>
        </arguments>
    </virtualType>
    <!-- Plan 3: reindex queue. The processor is the Plan 4 extension point (replace this preference). -->
    <preference for="Thedevkitchen\CmsSearch\Model\Queue\ReindexProcessorInterface"
                type="Thedevkitchen\CmsSearch\Model\Queue\NullReindexProcessor"/>
    <virtualType name="Thedevkitchen\CmsSearch\Model\Queue\Log\Handler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/cmssearch_reindex.log</argument>
        </arguments>
    </virtualType>
    <!-- Plain Monolog\Logger on purpose: a virtualType of Magento\Framework\Logger\Monolog would merge the core handlers
         (system, debug, syslog, support report) into ours and copy every line into those files. -->
    <virtualType name="Thedevkitchen\CmsSearch\Model\Queue\Log\Logger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">cmssearch_reindex</argument>
            <argument name="handlers" xsi:type="array">
                <item name="file" xsi:type="object">Thedevkitchen\CmsSearch\Model\Queue\Log\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Thedevkitchen\CmsSearch\Model\Queue\ReindexHandler">
        <arguments>
            <argument name="logger" xsi:type="object">Thedevkitchen\CmsSearch\Model\Queue\Log\Logger</argument>
        </arguments>
    </type>
    <preference for="Thedevkitchen\CmsSearch\Api\ReindexPublisherInterface"
                type="Thedevkitchen\CmsSearch\Model\Queue\ReindexPublisher"/>
    <type name="Thedevkitchen\CmsSearch\Model\Queue\MessageSender">
        <arguments>
            <argument name="logger" xsi:type="object">Thedevkitchen\CmsSearch\Model\Queue\Log\Logger</argument>
        </arguments>
    </type>
    <type name="Thedevkitchen\CmsSearch\Model\Queue\ReindexPublisher">
        <arguments>
            <argument name="logger" xsi:type="object">Thedevkitchen\CmsSearch\Model\Queue\Log\Logger</argument>
        </arguments>
    </type>
    <!-- After-commit flush of reindex requests (same interface as core's execute_commit_callbacks plugin). -->
    <type name="Magento\Framework\DB\Adapter\AdapterInterface">
        <plugin name="thedevkitchen_cmssearch_flush_reindex_messages"
                type="Thedevkitchen\CmsSearch\Plugin\Framework\DB\FlushReindexMessagesPlugin"/>
    </type>
    <type name="Thedevkitchen\CmsSearch\Plugin\Framework\DB\FlushReindexMessagesPlugin">
        <arguments>
            <argument name="sender" xsi:type="object">Thedevkitchen\CmsSearch\Model\Queue\MessageSender\Proxy</argument>
            <argument name="logger" xsi:type="object">Thedevkitchen\CmsSearch\Model\Queue\Log\Logger</argument>
        </arguments>
    </type>
    <!-- Staging (D9): scheduled page content that starts or ends asks for a page reindex. -->
    <type name="Magento\Staging\Model\StagingApplier">
        <arguments>
            <argument name="postProcessors" xsi:type="array">
                <item name="thedevkitchen_cmssearch_page" xsi:type="object">Thedevkitchen\CmsSearch\Model\Staging\PostProcessor\PageVersionApplied</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="thedevkitchen_cmssearch_reindex" xsi:type="object">Thedevkitchen\CmsSearch\Console\Command\ReindexCommand</item>
            </argument>
        </arguments>
    </type>
</config>
