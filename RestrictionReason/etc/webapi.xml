<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/thedevkitchen/restriction-reason/:websiteId" method="GET">
        <service class="Thedevkitchen\RestrictionReason\Api\RestrictionReasonRepositoryInterface"
                 method="getByWebsiteId"/>
        <resources>
            <resource ref="Thedevkitchen_RestrictionReason::reader"/>
        </resources>
    </route>
</routes>
